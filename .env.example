# 챗봇 서버(server/chat.mjs) 전용. 값을 채운 실제 .env 는 커밋하지 않는다
# (.gitignore 의 .env.* 가 막는다 — 이 예시 파일만 예외).
#
# 키가 비어 있거나 CHAT_LLM_ENABLED 가 false 면 서버는 규칙 기반(mode:
# rule/fallback)으로만 답한다 — 실제 모델 호출 없이도 npm run dev:chat 과
# npm run test:chat 은 전부 돌아간다.

# true 로 바꿔야 실제로 모델을 부른다. 기본은 false(꺼짐).
CHAT_LLM_ENABLED=false

# OpenAI API 키. platform.openai.com 에서 발급. 절대 커밋하지 않는다.
OPENAI_API_KEY=

# 쓸 모델 이름을 그대로 적는다 — 코드가 임의로 정하지 않는다.
OPENAI_MODEL=

# 챗봇 서버가 뜨는 포트. vite.config.js 의 프록시도 같은 값을 본다.
CHAT_PORT=8787

