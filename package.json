{
  "name": "qfit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Q-fit — 게임을 켰더니 운동이 끝나있다",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/clean.mjs && vite build",
    "preview": "vite preview --outDir .. --port 5180",
    "smoke": "node scripts/smoke.mjs",
    "flow": "node scripts/flow.mjs",
    "compare": "node scripts/compare.mjs",
    "phone": "node scripts/phone.mjs",
    "contrast": "node scripts/contrast.mjs",
    "coverage": "node scripts/coverage.mjs",
    "shot": "node scripts/shot.mjs",
    "nav": "node scripts/nav.mjs",
    "sheet": "node scripts/sheet.mjs",
    "weight": "node scripts/weight.mjs",
    "i18n": "node scripts/i18n.mjs",
    "reminder": "node scripts/reminder.mjs",
    "plan": "node scripts/plan.mjs",
    "stale": "node scripts/stale.mjs",
    "deploy": "npm run build && npx --yes wrangler deploy"
  },
  "devDependencies": {
    "ffmpeg-static": "^5.3.0",
    "playwright": "^1.62.1",
    "sharp": "^0.35.4",
    "vite": "^7.1.5",
    "vite-plugin-pwa": "^1.3.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.114.0"
  }
}
